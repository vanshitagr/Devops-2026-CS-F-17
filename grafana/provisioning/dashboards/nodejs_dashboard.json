    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 9, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull", "max", "min"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Process CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(process_cpu_user_seconds_total{job=\"my-own-website\"}[1m])",
          "legendFormat": "User CPU - {{instance}}"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(process_cpu_system_seconds_total{job=\"my-own-website\"}[1m])",
          "legendFormat": "Sys CPU - {{instance}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
